# Reforça no Apache que HTML/PHP não fica em cache agressivo (útil após git pull no servidor).
<IfModule mod_headers.c>
  <FilesMatch "\.(php|html?)$">
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_setenvif.c>
  SetEnvIf HTTPS "on" SIZO_HTTPS=1
  SetEnvIf X-Forwarded-Proto "https" SIZO_HTTPS=1
</IfModule>

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=SIZO_HTTPS
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Domínio canónico: sizotech.net -> www.sizotech.net (HTTP e HTTPS)
  RewriteCond %{HTTP_HOST} ^sizotech\.net$ [NC]
  RewriteRule ^ https://www.sizotech.net%{REQUEST_URI} [L,R=301]

  # Forçar HTTPS (compatível com Cloudways e Cloudflare)
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  RewriteRule ^api/sizotech/(.*)$ api/sizotech/index.php?route=$1 [QSA,L]
  RewriteRule ^api/analytics/(.*)$ api/analytics/index.php?route=$1 [QSA,L]
</IfModule>
