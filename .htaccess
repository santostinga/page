# Reforça no Apache que HTML/PHP não fica em cache agressivo (útil após git pull no servidor).
<IfModule mod_headers.c>
  <FilesMatch "\.(php|html?)$">
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_setenvif.c>
  SetEnvIf HTTPS "on" SIZO_HTTPS=1
  SetEnvIf X-Forwarded-Proto "https" SIZO_HTTPS=1
</IfModule>

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=SIZO_HTTPS
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Apenas produção: sizotech.net -> www.sizotech.net (HTTP e HTTPS).
  # Não aplicar a page.local / Laragon para evitar ERR_SSL_PROTOCOL_ERROR.
  RewriteCond %{HTTP_HOST} ^sizotech\.net$ [NC]
  RewriteRule ^ https://www.sizotech.net%{REQUEST_URI} [L,R=301]

  # Forçar HTTPS só no domínio público (Cloudways / Cloudflare).
  RewriteCond %{HTTP_HOST} ^(www\.)?sizotech\.net$ [NC]
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  RewriteRule ^api/sizotech/(.*)$ api/sizotech/index.php?route=$1 [QSA,L]
  RewriteRule ^api/analytics/(.*)$ api/analytics/index.php?route=$1 [QSA,L]

  # Página de registo (cadastro)
  RewriteRule ^register/?$ register.php [L,QSA]
  RewriteRule ^cadastro/?$ register.php [L,QSA]

  # Convite de casamento — link personalizado (ex.: /santos-esposa)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !^/api/ [NC]
  RewriteCond %{REQUEST_URI} !^/assets/ [NC]
  RewriteCond %{REQUEST_URI} !^/storage/ [NC]
  RewriteCond %{REQUEST_URI} !^/admin/ [NC]
  RewriteCond %{REQUEST_URI} !^/favicon\.ico$ [NC]
  RewriteCond %{REQUEST_URI} !^/robots\.txt$ [NC]
  RewriteRule ^([a-z0-9][a-z0-9-]*)/?$ convite.php?slug=$1 [L,QSA]

  # Bloquear acesso directo ao ficheiro de analytics
  RewriteRule ^storage/ - [F,L]
</IfModule>
