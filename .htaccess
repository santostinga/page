# Reforça no Apache que HTML/PHP não fica em cache agressivo (útil após git pull no servidor).
<IfModule mod_headers.c>
  <FilesMatch "\.(php|html?)$">
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^api/sizotech/(.*)$ api/sizotech/index.php?route=$1 [QSA,L]
</IfModule>
