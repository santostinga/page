DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=bcamzuhrcm
DB_USER=bcamzuhrcm
DB_PASS=

# Comunicação servidor-a-servidor com o sistema Sizo (não expor no browser).
SIZOTECH_API_BASE_URL=https://admin.sizotech.net/api/v1
SIZOTECH_API_KEY=
# Nomes legados aceites temporariamente: SIZO_SYSTEM_URL= e SIZO_SYSTEM_API_KEY=

# Pasta com logos no servidor (ajuste ao path real da app Sizo no Cloudways)
COMPANY_UPLOADS_PATH=/home/master/applications/bcamzuhrcm/public_html/uploads/empresas

# Analytics do website (ficheiro SQLite local — sem MySQL)
ANALYTICS_ENABLED=true
ANALYTICS_TOKEN=altere-para-um-token-seguro-longo
# ANALYTICS_STORAGE_PATH=storage/analytics.sqlite
# ANALYTICS_SALT=opcional-salt-para-hash-de-visitantes
